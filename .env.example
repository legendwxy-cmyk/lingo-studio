# ==========================================================
# Lingo 云服务器生产配置模板
# 复制本文件为 .env 后修改：cp .env.example .env
# ==========================================================

# 【强烈建议】公网访问口令（留空表示不启用登录锁，适合纯内网/本地使用）
# 设置后，所有 API、上传的视频/音频/封面和生词本导出均需输入口令登录才可访问
APP_ACCESS_PASSWORD=请改为你的强密码

# 会话 Cookie 签名密钥（建议改为任意 32 位随机字符；留空则由口令派生）
APP_SECRET_KEY=

# 对外映射端口（纯 HTTP 模式默认 8000；若配合 Caddy HTTPS 模式则走 80/443）
APP_PORT=8000

# 单次上传视频/音频最大体积限制（MB，防止误传超大文件占满云盘）
MAX_UPLOAD_MB=500
