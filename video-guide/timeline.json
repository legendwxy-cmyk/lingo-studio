    "mac_block": {
      "id": "c04",
      "scene": "S02",
      "cue": "mac_block",
      "start": 16.566,
      "end": 23.894,
      "duration": 7.328,
      "text": "第二步很关键。首次打开若提示无法验证开发者，别担心，先点完成关闭弹窗。",
      "subs": [
        {
          "start": 16.566,
          "end": 20.23,
          "text": "首次打开若提示无法验证开发者"
        },
        {
          "start": 20.23,
          "end": 23.894,
          "text": "别担心，先点「完成」关闭弹窗"
        }
      ]
    },
    "mac_settings": {
      "id": "c05",
      "scene": "S02",
      "cue": "mac_settings",
      "start": 24.134,
      "end": 29.414,
      "duration": 5.28,
      "text": "打开 Mac 系统设置，点进隐私与安全性，向下滑到安全性一栏。",
      "subs": [
        {
          "start": 24.134,
          "end": 27.18,
          "text": "打开系统设置 → 隐私与安全性"
        },
        {
          "start": 27.18,
          "end": 29.414,
          "text": "向下滑到「安全性」一栏"
        }
      ]
    },
    "mac_open_anyway": {
      "id": "c06",
      "scene": "S02",
      "cue": "mac_open_anyway",
      "start": 29.654,
      "end": 35.512,
      "duration": 5.858,
      "text": "找到已阻止使用 Lingo，点击右侧仍要打开并输入密码，一次永久放行。",
      "subs": [
        {
          "start": 29.654,
          "end": 32.934,
          "text": "点击右侧「仍要打开」输入密码"
        },
        {
          "start": 32.934,
          "end": 35.512,
          "text": "一次放行，以后不再拦截"
        }
      ]
    },
    "mac_local_net": {
