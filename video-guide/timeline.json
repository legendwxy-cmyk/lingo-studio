      ]
    },
    {
      "id": "c09",
      "scene": "S03",
      "cue": "hud_init",
      "start": 48.253,
      "end": 56.454,
      "duration": 8.201,
      "text": "第三步，环境与依赖自检。首次启动会弹出原生进度浮窗自动准备，全程免开黑色命令行。",
      "subs": [
        {
          "start": 48.253,
          "end": 52.809,
          "text": "首次启动由原生进度浮窗自动准备"
        },
        {
          "start": 52.809,
          "end": 56.454,
          "text": "全程免开黑色命令行敲指令"
        }
      ]
    },
    {
      "id": "c10",
      "scene": "S03",
      "cue": "env_open",
      "start": 56.694,
      "end": 60.29,
      "duration": 3.596,
      "text": "进入桌面控制台，点开顶部的环境与依赖页。",
      "subs": [
        {
          "start": 56.694,
